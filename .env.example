PORT=3000
NODE_ENV=development

# postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://ums:ums@localhost:5433/ums_payments?schema=public

# cashfree - get these from merchant dashboard -> Developers -> API keys (Test mode)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01

# where cashfree redirects the student after checkout ({order_id} is replaced by cashfree)
PAYMENT_RETURN_URL=http://localhost:3000/?order_id={order_id}
# public url of our webhook endpoint (use ngrok in local dev), leave empty to rely on dashboard config
PAYMENT_NOTIFY_URL=

# when set, cancel and reconcile need an x-admin-key header with this value (leave empty locally)
ADMIN_API_KEY=

# minutes after which an unpaid order is expired
ORDER_EXPIRY_MINUTES=30
